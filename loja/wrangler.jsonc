{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loja-minecraft",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // The React bundle is served as static assets; any route that is not a file
    // falls back to index.html (SPA) — except /api/*, handled by the Worker.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  // Reconciles orders awaiting payment and expires the overdue ones, in case
  // the gateway webhook fails or is lost.
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loja-minecraft",
      "database_id": "FILL_IN_AFTER_CREATING_THE_DATABASE",
      "migrations_dir": "./migrations"
    }
  ],

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "loja-minecraft-images" }],

  "kv_namespaces": [{ "binding": "SESSIONS", "id": "FILL_IN_AFTER_CREATING_THE_NAMESPACE" }],

  "vars": {
    "ENVIRONMENT": "production",
    // "mock" in development (see .dev.vars), "mercadopago" in production.
    "PAYMENT_PROVIDER": "mercadopago",

    // Turnstile PUBLIC key (the secret one goes through `wrangler secret`).
    // Empty disables the widget and the anti-bot check on checkout.
    "TURNSTILE_SITE_KEY": ""
  }

  // Secrets (never here — use `wrangler secret put`):
  //   MERCADOPAGO_ACCESS_TOKEN
  //   MERCADOPAGO_WEBHOOK_SECRET
  //   SESSION_SECRET
  //   TURNSTILE_SECRET_KEY
}
